# Keep the build context small and the image reproducible.

# Node / Vite
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime output — the container creates its own empty log
feedback_logs/*.csv

# Repo / editor cruft
.git/
.github/
.devcontainer/
.agents/
.claude/
.idea/
.vscode/
.DS_Store

# Documentation is not needed at runtime
docs/
